# direnv: automatically activate the project virtualenv when you enter this
# directory (and deactivate when you leave).  Optional convenience - install
# direnv, then run "direnv allow" once.
if [ -f .venv/bin/activate ]; then
    source .venv/bin/activate
else
    python3 -m venv .venv
    source .venv/bin/activate
    pip install --upgrade pip >/dev/null
    pip install -r requirements.txt
fi
